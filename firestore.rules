rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // User Profile Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.name is string &&
             data.name.size() <= 100;
    }

    // Resume Validation
    function isValidResume(data) {
      return data.keys().hasAll(['userId', 'score', 'technicalSkills']) &&
             data.userId == request.auth.uid &&
             data.score is number &&
             data.score >= 0 && data.score <= 100 &&
             data.technicalSkills is list;
    }

    // Interview Validation
    function isValidInterview(data) {
      return data.keys().hasAll(['userId', 'jobRole']) &&
             data.userId == request.auth.uid &&
             data.jobRole is string &&
             data.overallScore is number;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if true;
      allow list: if true;
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']);
    }

    // 2. Resumes Collection
    match /resumes/{resumeId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidResume(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    // 3. Interviews Collection
    match /interviews/{interviewId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidInterview(request.resource.data);
      allow delete: if false;
    }

    // 4. Courses Collection
    match /courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }
    
    // 5. Admin collection
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
